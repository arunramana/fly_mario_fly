# What this file does, in plain English:
# Tells git which files never to save: the virtual environment, Python's
# compiled caches, videos and images (re-renderable from the saved telemetry
# CSVs), log files, and the large connectome data files.
.venv/
__pycache__/
*.pyc
*.mp4
*.png
# Exception: tool/README.md's own screenshots are documentation, not a run's
# re-renderable output -- these are the only PNGs meant to be committed.
!tool/docs/screenshots/*.png
!tool/docs/screenshots/redesign/*.png
# Exception: tool/SPEC_ui_retro.md section 9's card images -- the
# placeholder ships with the feature (generated once, not per-run), and
# user-supplied character/entity card images are real assets, not a run's
# re-renderable output. tool/assets/generated/ (section 8's circuit brain-
# maps) stays ignored -- those ARE regenerable from the connectome data.
!tool/assets/placeholder.png
!tool/assets/characters/*.png
!tool/assets/entities/*.png
# Downloaded SMB1 sprites (Super Mario Wiki): Nintendo art, kept local only.
tool/assets/sprites/
tool/assets/derived/
*.parquet
*.feather
.pytest_cache/
# Outputs live in projects/<name>/runs/; stray top-level runs/ from old defaults.
/runs/
# Per-run log files (config/logging_setup.py); telemetry CSVs are the record.
/logs/
