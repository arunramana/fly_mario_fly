# What this file does, in plain English:
# Tells git which files never to save: the virtual environment, Python's
# compiled caches, videos and images (re-renderable from the saved telemetry
# CSVs), and the large connectome data files.
.venv/
__pycache__/
*.pyc
*.mp4
*.png
*.parquet
*.feather
.pytest_cache/
# Outputs live in projects/<name>/runs/; stray top-level runs/ from old defaults.
/runs/
