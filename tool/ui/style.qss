/* tool/ui/style.qss -- tool/SPEC_ui_retro.md section 5: the retro/
   video-game theme, loaded once (QApplication.setStyleSheet) at startup
   (tool/ui/app.py) -- no per-widget inline styling scattered across tab
   files. The six colour placeholders below (SKY_BLUE, MARIO_RED,
   LUIGI_GREEN, BRICK_BROWN, BLACK, WHITE, each wrapped in a leading and
   trailing "at" sign) are substituted from tool/ui/palette_colors.py's
   own constants at load time, a plain string replace (QSS has no
   variables) -- never hand-duplicated here as a literal hex code.

   Press Start 2P (bundled, tool/assets/fonts/) is reserved for headers,
   labels, buttons and tabs -- a pixel font at small sizes is often
   illegible, and a 60-scalar form in it at a readable size would not fit
   on screen. Spin/combo/line-edit fields keep a normal monospace font. */

QWidget {
    background-color: @SKY_BLUE@;
    color: @BLACK@;
    font-family: "Press Start 2P", sans-serif;
    font-size: 10pt;
}

QDoubleSpinBox, QSpinBox, QComboBox, QLineEdit, QTextEdit {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11pt;
    background-color: @WHITE@;
    color: @BLACK@;
    border: 2px solid @BLACK@;
    padding: 2px;
}

QGroupBox {
    border: 3px solid @BLACK@;
    margin-top: 16px;
    padding-top: 10px;
    background-color: @SKY_BLUE@;
    font-size: 9pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 2px 6px;
    color: @WHITE@;
    background-color: @BRICK_BROWN@;
}

QPushButton {
    font-family: "Press Start 2P", sans-serif;
    font-size: 9pt;
    background-color: @BRICK_BROWN@;
    color: @WHITE@;
    border: 3px solid @BLACK@;
    min-height: 32px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: @MARIO_RED@;
}

QPushButton:checked {
    background-color: @LUIGI_GREEN@;
    border-color: @WHITE@;
}

QPushButton:pressed {
    background-color: @BRICK_BROWN@;
    border-color: @WHITE@;
}

QPushButton:disabled {
    background-color: #888888;
    color: #cccccc;
    border-color: #555555;
}

/* Ease-of-use redesign: picture cards (tool/ui/widgets/card_button.py)
   are QToolButton, not QPushButton -- icon-above-text needs
   ToolButtonTextUnderIcon, which QPushButton doesn't support. Same
   look as a QPushButton otherwise, so a card reads as the same kind of
   clickable thing as every other button in this theme. */
QToolButton {
    font-family: "Press Start 2P", sans-serif;
    font-size: 9pt;
    background-color: @BRICK_BROWN@;
    color: @WHITE@;
    border: 3px solid @BLACK@;
    padding: 6px;
}

QToolButton:hover {
    background-color: @MARIO_RED@;
}

QToolButton:checked {
    background-color: @LUIGI_GREEN@;
    border-color: @WHITE@;
}

QToolButton:disabled {
    background-color: #888888;
    color: #cccccc;
    border-color: #555555;
}

/* Run tab / header redesign: Home, Presets, Save and START are the same
   widget kind of thing (a header action), so they share this ONE rule --
   same size, padding and font regardless of QPushButton vs QToolButton.
   Set via `widget.setProperty("headerButton", True)`, not an objectName,
   so one selector covers both widget classes. START stands out by colour
   only (the `headerAccent` property below), never by size -- found in
   manual testing: a bigger START read as "the real button" and made the
   other three look disabled even when they weren't. */
QPushButton[headerButton="true"], QToolButton[headerButton="true"] {
    font-family: "Press Start 2P", sans-serif;
    font-size: 9pt;
    background-color: @BRICK_BROWN@;
    color: @WHITE@;
    border: 3px solid @BLACK@;
    min-height: 32px;
    padding: 8px 14px;
}

QPushButton[headerButton="true"]:hover, QToolButton[headerButton="true"]:hover {
    background-color: @MARIO_RED@;
}

QPushButton[headerButton="true"]:pressed, QToolButton[headerButton="true"]:pressed {
    background-color: @BRICK_BROWN@;
    border-color: @WHITE@;
}

QPushButton[headerButton="true"]:disabled, QToolButton[headerButton="true"]:disabled {
    background-color: #888888;
    color: #cccccc;
    border-color: #555555;
}

QPushButton[headerButton="true"]:focus, QToolButton[headerButton="true"]:focus {
    outline: none;
    border-color: @WHITE@;
}

/* START only: colour, not size (see the rule block's own comment above). */
QPushButton[headerButton="true"][headerAccent="true"] {
    background-color: @MARIO_RED@;
}

QPushButton[headerButton="true"][headerAccent="true"]:hover {
    background-color: @LUIGI_GREEN@;
}

QTabWidget::pane {
    border: 3px solid @BLACK@;
    background-color: @SKY_BLUE@;
}

QTabBar::tab {
    /* Ease-of-use redesign: bigger tab labels -- was 8pt/8x12 padding. */
    font-family: "Press Start 2P", sans-serif;
    background-color: @BRICK_BROWN@;
    color: @WHITE@;
    border: 2px solid @BLACK@;
    padding: 12px 18px;
    font-size: 11pt;
}

QTabBar::tab:selected {
    background-color: @MARIO_RED@;
}

QProgressBar {
    border: 2px solid @BLACK@;
    background-color: @WHITE@;
    text-align: center;
    color: @BLACK@;
}

QProgressBar::chunk {
    background-color: @LUIGI_GREEN@;
}

QCheckBox, QRadioButton {
    font-family: "Press Start 2P", sans-serif;
    font-size: 8pt;
    spacing: 8px;
}

/* Ease-of-use redesign: visible focus outlines -- keyboard/tab
   navigation must always show where focus actually is. A distinct
   colour from the checked/hover states above so focus is never
   confused with either. */
QPushButton:focus, QCheckBox:focus, QRadioButton:focus {
    outline: none;
    border-color: @WHITE@;
}

QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus, QLineEdit:focus,
QTextEdit:focus, QSlider:focus, QTableWidget:focus {
    outline: none;
    border: 2px solid @MARIO_RED@;
}

/* Ease-of-use redesign: stat chips above the Run tab's player. */
QLabel#statChip {
    background-color: @BRICK_BROWN@;
    color: @WHITE@;
    border: 2px solid @BLACK@;
    padding: 4px 10px;
    font-size: 8pt;
}

/* Run tab / player redesign: the auto-hiding transport bar sits ON TOP of
   the video (a child of the canvas, not its own layout row), so it needs
   its own background rather than the theme's sky-blue showing through. */
QWidget#transportBar {
    background-color: rgba(20, 20, 20, 200);
    border-top: 2px solid @BLACK@;
}

QWidget#transportBar QLabel {
    color: @WHITE@;
    background-color: transparent;
}

QLabel#liveBadge {
    background-color: @MARIO_RED@;
    color: @WHITE@;
    font-size: 9pt;
    padding: 4px 10px;
    border: 2px solid @BLACK@;
}

/* Run tab / player redesign: overlay panels (Brain map/Data/Config) over
   the video. The Data overlay is a "see-through readout" by request --
   translucent black, not the theme's own sky-blue, so it reads on top of
   any frame without fighting the video for attention. */
/* Player edge panels: semi-transparent dark, over the video's margins. */
QWidget#edgePanel { background-color: rgba(10, 10, 10, 175); }
QPushButton#edgePanelTab { min-height: 20px; padding: 3px 10px; font-size: 8pt; }
QWidget#edgePanel QTextEdit {
    background-color: transparent; color: @WHITE@; border: none;
    font-family: "Consolas", "Courier New", monospace; font-size: 9pt;
}
QWidget#edgePanel QLabel { background-color: transparent; color: @WHITE@; }

QWidget#dataOverlayContent {
    background-color: transparent;
}

QWidget#dataOverlayContent QLabel {
    background-color: transparent;
    color: @WHITE@;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
}

/* Ease-of-use redesign: the read-only reference project's own banner --
   a warning colour distinct from every other background in this theme,
   so it reads as "different from a normal project" at a glance. */
QLabel#readOnlyBanner {
    background-color: @BRICK_BROWN@;
    color: @WHITE@;
    border: 3px solid @MARIO_RED@;
    padding: 8px;
    font-size: 9pt;
}
